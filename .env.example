# Copy this file to `.env` for `docker compose` to pick up.
# Defaults below are good for the synthetic-pipeline experiments — change
# them only if a different postgres password is desired.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social

# Single-tenant deployment — RLS uses this id throughout the experiments
TENANT_ID=default

# Logging level for the AI service (debug | info | warn | error)
LOG_LEVEL=info
